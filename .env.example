# Create a bot with Telegram @BotFather. Keep its token private.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram IDs, separated by commas. /whoami shows your ID.
ADMIN_IDS=
# Optional solo test assignment target. Must be a configured admin ID.
TEST_EDITOR_ID=
# Leave these blank and bind the groups with admin commands in Telegram.
UPLOADERS_CHAT_ID=
EDITORS_CHAT_ID=
TIMEZONE=Asia/Kolkata
# effort = equal assigned effort; rotation = equal assigned video count.
ASSIGNMENT_MODE=effort
MAX_ACTIVE_JOBS=2
DEADLINE_HOURS=24
REQUIRE_APPROVAL=true
REPORT_HOUR=9
DATABASE_PATH=data/bot.sqlite3
# Required on Render. Use an external Postgres database with SSL enabled.
DATABASE_URL=
# On Render, self-ping the provided RENDER_EXTERNAL_URL every 5 minutes.
# Best effort only; cannot restart an already sleeping service.
KEEP_ALIVE_ENABLED=true
